{
  // Cloudflare Workers: static assets from dist/ + one Worker for the API + D1.
  // `npm run deploy` builds dist/ and deploys both.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polish-cases",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-01",
  "upload_source_maps": true,

  // Custom domain on the hammad.lol zone; claimed by `wrangler deploy`.
  "routes": [{ "pattern": "cases.hammad.lol", "custom_domain": true }],

  // Serve on the custom domain and on the workers.dev subdomain, as the README
  // documents for both hosts.
  "workers_dev": true,

  "assets": {
    // The binding name the Worker uses (env.ASSETS) for anything the edge
    // cannot serve itself, such as unknown paths — without it those throw.
    "binding": "ASSETS",
    "directory": "./dist",
    // Only the API needs the Worker; every other path, 404s included, is served
    // or answered by the asset server without an invocation.
    "run_worker_first": ["/api/*"]
  },

  // Sync failures are logged as structured JSON; keep them where they can be
  // queried in the dashboard, and trace the requests that reach the API. The
  // sync code travels in a header, so neither records it.
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polski-cases-progress",
      // Filled in by `wrangler d1 create polski-cases-progress` — see README.
      "database_id": "6934a9d9-7975-4927-ad95-29bdabfd8729"
    }
  ]
}
